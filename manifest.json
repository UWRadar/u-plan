{
  "manifest_version": 3,
  "name": "U Plan by 华大课友",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "在 UW MyPlan 中一起查看华大课友课程评价与教授评分。",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://www.ratemyprofessors.com/*"],
  "background": { "service_worker": "scripts/background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "U Plan · 华大课友" },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "css": ["scripts/table.css"],
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "https://myplan.uw.edu/course/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "scripts/course-frame.js"
      ],
      "matches": [
        "https://uwclassmate.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
